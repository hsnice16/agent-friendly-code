NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_APP_URL=https://agentfriendlycode.com

# ---------- Host API tokens ----------
# Raise rate limits when fetching repo metadata (stars, default branch) during
# `bun run score` / `bun run seed`. Optional for the CLI — just slower against
# the unauthenticated ceiling.
#
# GITHUB_TOKEN is REQUIRED for the deployed app: /score/* calls api.github.com,
# which allows 60 requests/hour per IP unauthenticated, and serverless egress
# IPs are shared. Tokenized it is 5,000/hour.

# Fine-grained PAT with read-only access to public repositories, or a classic
# PAT with no scopes. Not `public_repo`: that scope grants write access.
GITHUB_TOKEN=

# GitLab personal access token with read_api scope.
GITLAB_TOKEN=

# ---------- Local overrides ----------
# Open this SQLite file instead of data/rank.db, e.g. to rehearse `bun run seed`
# on a copy. data/rank.db is rewritten on main every few hours, so local writes
# to it conflict on the next pull.
# RANK_DB_PATH=

