{
  "name": "agent-friendly-code",
  "version": "0.9.3",
  "description": "Scores how ready a repo is for AI coding agents, one score per agent. Ranked public repos, a live score by URL, an agent skill and a GitHub Action.",
  "private": true,
  "license": "MIT",
  "author": "Himanshu Singh (https://github.com/hsnice16)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "score": "tsx scripts/score.ts score",
    "parity-check": "tsx scripts/parity-check.ts",
    "seed": "tsx scripts/seed.ts",
    "seed-packages": "tsx scripts/seed-packages.ts",
    "audit-seeds": "tsx scripts/audit-seeds.ts",
    "init-db": "tsx scripts/init-db.ts",
    "check-db-leaks": "tsx scripts/check-db-leaks.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "prepare-hooks": "lefthook install",
    "test": "node --import tsx --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "12.9.0",
    "ignore": "7.0.5",
    "next": "16.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@tailwindcss/postcss": "4.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lefthook": "2.1.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.2.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "source-map-js": "1.2.2"
  }
}
